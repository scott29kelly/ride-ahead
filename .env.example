# ---------------------------------------------------------------------------
# RideAhead configuration
#
# The app runs with none of these set (demo mode). Add keys to go live.
# Copy to .env.local and fill in what you have.
# ---------------------------------------------------------------------------

# Serve bundled sample routes instead of calling any API. Set to 0 to go live.
RIDEAHEAD_DEMO=1

# Routing with real cycling profiles + elevation. Free tier, no card required.
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Street-level photos, including bike paths and trails Street View never drove.
# Free. https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Optional. Best image quality where it exists, but billed per request.
# https://console.cloud.google.com/apis/library/street-view-image-backend.googleapis.com
GOOGLE_MAPS_API_KEY=

# Nominatim and Overpass ask that you identify your app with contact details.
RIDEAHEAD_USER_AGENT="RideAhead/0.1 (you@example.com)"
